FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils ca-certificates libfontconfig1 fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm run typecheck:libs
RUN API_SERVER_ENTRYPOINT=src/mapping-pilot-server.ts pnpm --filter @workspace/api-server build
ENV NODE_ENV=production
WORKDIR /app/artifacts/api-server
CMD ["node", "--enable-source-maps", "dist/mapping-pilot-server.mjs"]
